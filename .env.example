# Copy to .env and replace every placeholder. Never commit the real .env file.
# Backend variables use the IIOS_ prefix (see backend/app/core/config.py).

# --- General ---------------------------------------------------------------
IIOS_ENVIRONMENT=development            # development | test | production
IIOS_LOG_LEVEL=INFO
IIOS_LOG_JSON=true

# --- Database ----------------------------------------------------------------
# Development may use SQLite (default: backend/data/iios.db). Production requires
# PostgreSQL with a NON-superuser, NON-BYPASSRLS role so row-level security applies.
# IIOS_DATABASE_URL=postgresql+psycopg://iios_app:CHANGE_ME@localhost:5432/iios

# docker-compose only
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
IIOS_DB_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# Backups/restores need a role with BYPASSRLS (or superuser); see docs/DEPLOYMENT.md
# IIOS_BACKUP_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/iios

# --- Files -------------------------------------------------------------------
# IIOS_STORAGE_DIR=/var/lib/iios/storage
IIOS_MAX_UPLOAD_MB=20

# --- Sessions and security ---------------------------------------------------------
IIOS_COOKIE_SECURE=true                 # false ONLY for http://localhost development
IIOS_SESSION_IDLE_TIMEOUT_MINUTES=120
IIOS_SESSION_ABSOLUTE_TIMEOUT_HOURS=24
IIOS_MAX_FAILED_LOGINS=5
IIOS_LOCKOUT_MINUTES=15
IIOS_LOGIN_RATE_LIMIT_PER_MINUTE=10
IIOS_API_RATE_LIMIT_PER_MINUTE=300
IIOS_ALLOW_SELF_SIGNUP=false
# Uvicorn: trust X-Forwarded-For ONLY from the reverse proxy / frontend address
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Password recovery e-mail (SMTP) -------------------------------------------------
IIOS_PUBLIC_APP_URL=http://localhost:3000
IIOS_SMTP_HOST=
IIOS_SMTP_PORT=587
IIOS_SMTP_USERNAME=
IIOS_SMTP_PASSWORD=
IIOS_SMTP_FROM=
IIOS_SMTP_STARTTLS=true

# --- Branding (white label) -----------------------------------------------------------
IIOS_BRAND_NAME=Industrial Intelligence OS
IIOS_BRAND_SHORT_NAME=IIOS
IIOS_BRAND_PRIMARY_COLOR=#0f766e
NEXT_PUBLIC_BRAND_NAME=Industrial Intelligence OS
NEXT_PUBLIC_BRAND_SHORT_NAME=IIOS
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=#0f766e

# --- Frontend ----------------------------------------------------------------
IIOS_BACKEND_URL=http://127.0.0.1:8000

# --- End-to-end test (frontend/e2e) ----------------------------------------------------
# E2E_EMAIL=
# E2E_PASSWORD=
